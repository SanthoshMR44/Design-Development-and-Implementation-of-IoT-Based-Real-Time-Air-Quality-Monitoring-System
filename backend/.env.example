# AQMS Backend Environment Variables
# Copy this file to .env and fill in values

NODE_ENV=development
PORT=5000

# MongoDB (optional - demo data used if not set)
MONGODB_URI=mongodb://localhost:27017/aqms

# Security
JWT_SECRET=your-strong-jwt-secret-here
CORS_ORIGIN=http://localhost:5173

# MQTT (optional - for real ESP32/AQMi hardware)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# AWS (optional - for cloud deployment)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Email (optional - for contact/demo requests)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@aqms.io
